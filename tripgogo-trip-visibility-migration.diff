diff --git a/supabase/migrations/006_tripgogo_trip_visibility.sql b/supabase/migrations/006_tripgogo_trip_visibility.sql
new file mode 100644
index 0000000..d73f0b2
--- /dev/null
+++ b/supabase/migrations/006_tripgogo_trip_visibility.sql
@@ -0,0 +1,237 @@
+-- ============================================================
+-- TRAVEL GOGO — public/private Trip visibility
+-- Requires 004_tripgogo_schema_rls.sql and
+--          005_tripgogo_repository_rpcs.sql.
+--
+-- This migration only changes tg_* objects. Existing Trips remain
+-- public because is_public is NOT NULL with a true default.
+-- ============================================================
+
+begin;
+
+alter table public.tg_trips
+  add column if not exists is_public boolean not null default true;
+
+-- Defensive backfill for projects where the column may have been added
+-- manually without the final constraint/default before this migration.
+update public.tg_trips set is_public = true where is_public is null;
+alter table public.tg_trips alter column is_public set default true;
+alter table public.tg_trips alter column is_public set not null;
+
+create index if not exists tg_trips_visibility_start_date_idx
+  on public.tg_trips (is_public, start_date);
+
+-- A narrow visibility helper used by parent and child SELECT policies.
+-- SECURITY DEFINER avoids recursive RLS while exposing only a boolean.
+create or replace function public.tg_can_read_trip(p_trip_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = pg_catalog, public
+as $$
+  select exists (
+    select 1
+    from public.tg_trips trip
+    where trip.id = p_trip_id
+      and (
+        trip.is_public = true
+        or exists (
+          select 1
+          from public.tg_trip_members member
+          where member.trip_id = trip.id
+            and member.user_id = auth.uid()
+        )
+      )
+  );
+$$;
+
+revoke all on function public.tg_can_read_trip(uuid) from public;
+grant execute on function public.tg_can_read_trip(uuid) to anon, authenticated;
+
+-- ------------------------------------------------------------
+-- Visibility-aware SELECT policies
+-- ------------------------------------------------------------
+
+drop policy if exists "tg_trips_public_read" on public.tg_trips;
+create policy "tg_trips_visibility_read" on public.tg_trips
+  for select to anon, authenticated
+  using (public.tg_can_read_trip(id));
+
+drop policy if exists "tg_travel_items_public_read" on public.tg_travel_items;
+create policy "tg_travel_items_visibility_read" on public.tg_travel_items
+  for select to anon, authenticated
+  using (public.tg_can_read_trip(trip_id));
+
+drop policy if exists "tg_flights_public_read" on public.tg_flights;
+create policy "tg_flights_visibility_read" on public.tg_flights
+  for select to anon, authenticated
+  using (public.tg_can_read_trip(trip_id));
+
+drop policy if exists "tg_hotel_stays_public_read" on public.tg_hotel_stays;
+create policy "tg_hotel_stays_visibility_read" on public.tg_hotel_stays
+  for select to anon, authenticated
+  using (public.tg_can_read_trip(trip_id));
+
+-- ------------------------------------------------------------
+-- Owner-only visibility changes
+--
+-- The trigger protects the column even if an editor bypasses the UI and
+-- calls UPDATE directly. The RPC is the intended application entry point.
+-- ------------------------------------------------------------
+
+create or replace function public.tg_enforce_visibility_owner()
+returns trigger
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+begin
+  if new.is_public is distinct from old.is_public
+     and not public.tg_is_trip_owner(old.id) then
+    raise exception 'Only the Trip owner can change visibility';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists tg_trips_enforce_visibility_owner on public.tg_trips;
+create trigger tg_trips_enforce_visibility_owner
+  before update of is_public on public.tg_trips
+  for each row execute function public.tg_enforce_visibility_owner();
+
+create or replace function public.tg_set_trip_visibility(
+  p_trip_id uuid,
+  p_is_public boolean
+)
+returns void
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+begin
+  if auth.uid() is null or not public.tg_is_trip_owner(p_trip_id) then
+    raise exception 'Only the Trip owner can change visibility';
+  end if;
+  if p_is_public is null then
+    raise exception 'Trip visibility is required';
+  end if;
+
+  update public.tg_trips
+  set is_public = p_is_public
+  where id = p_trip_id;
+
+  if not found then
+    raise exception 'Trip not found';
+  end if;
+end;
+$$;
+
+revoke all on function public.tg_set_trip_visibility(uuid, boolean) from public;
+grant execute on function public.tg_set_trip_visibility(uuid, boolean) to authenticated;
+
+-- ------------------------------------------------------------
+-- Pending invitation summary
+--
+-- Invitees can see only the five fields declared below. The function does
+-- not grant SELECT access to a private Trip or expose dates/content/members.
+-- ------------------------------------------------------------
+
+create or replace function public.tg_get_my_pending_trip_invitations()
+returns table (
+  invitation_id uuid,
+  trip_id uuid,
+  trip_name text,
+  created_at timestamptz,
+  expires_at timestamptz
+)
+language sql
+stable
+security definer
+set search_path = pg_catalog, public
+as $$
+  select
+    invitation.id as invitation_id,
+    invitation.trip_id,
+    trip.name as trip_name,
+    invitation.created_at,
+    invitation.expires_at
+  from public.tg_trip_invitations invitation
+  join public.tg_trips trip on trip.id = invitation.trip_id
+  where auth.uid() is not null
+    and lower(invitation.email) = lower(btrim(coalesce(auth.jwt() ->> 'email', '')))
+    and invitation.accepted_at is null
+    and (invitation.expires_at is null or invitation.expires_at > now())
+  order by invitation.created_at;
+$$;
+
+revoke all on function public.tg_get_my_pending_trip_invitations() from public;
+grant execute on function public.tg_get_my_pending_trip_invitations() to authenticated;
+
+-- ------------------------------------------------------------
+-- Keep duplicate behavior complete: the copy inherits source visibility,
+-- while the authenticated copier becomes owner of the new Trip.
+-- ------------------------------------------------------------
+
+create or replace function public.tg_duplicate_trip(p_trip_id uuid)
+returns uuid
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_new_trip_id uuid := gen_random_uuid();
+begin
+  if v_user_id is null or not public.tg_is_trip_member(p_trip_id) then
+    raise exception 'Trip edit permission is required';
+  end if;
+
+  insert into public.tg_trips (id, owner_id, name, start_date, end_date, is_public)
+  select v_new_trip_id, v_user_id, name || ' - 複製', start_date, end_date, is_public
+  from public.tg_trips
+  where id = p_trip_id;
+
+  if not found then
+    raise exception 'Trip not found';
+  end if;
+
+  insert into public.tg_travel_items (
+    id, trip_id, created_by, type, category, area, date, name, google_maps_url,
+    extra_link_1, extra_link_2, business_hours, note, sort_order
+  )
+  select
+    gen_random_uuid(), v_new_trip_id, v_user_id, type, category, area, date, name,
+    google_maps_url, extra_link_1, extra_link_2, business_hours, note, sort_order
+  from public.tg_travel_items
+  where trip_id = p_trip_id;
+
+  insert into public.tg_flights (
+    id, trip_id, created_by, airline, flight_number, departure_place, arrival_place,
+    departure_date, departure_time, arrival_date, arrival_time, link, note
+  )
+  select
+    gen_random_uuid(), v_new_trip_id, v_user_id, airline, flight_number,
+    departure_place, arrival_place, departure_date, departure_time,
+    arrival_date, arrival_time, link, note
+  from public.tg_flights
+  where trip_id = p_trip_id;
+
+  insert into public.tg_hotel_stays (
+    id, trip_id, created_by, name, check_in_date, check_out_date, check_in_time,
+    check_out_time, address, phone, google_maps_url, link, note
+  )
+  select
+    gen_random_uuid(), v_new_trip_id, v_user_id, name, check_in_date, check_out_date,
+    check_in_time, check_out_time, address, phone, google_maps_url, link, note
+  from public.tg_hotel_stays
+  where trip_id = p_trip_id;
+
+  return v_new_trip_id;
+end;
+$$;
+
+revoke all on function public.tg_duplicate_trip(uuid) from public;
+grant execute on function public.tg_duplicate_trip(uuid) to authenticated;
+
+commit;

