diff --git a/supabase/migrations/004_tripgogo_schema_rls.sql b/supabase/migrations/004_tripgogo_schema_rls.sql
new file mode 100644
index 0000000..3b79972
--- /dev/null
+++ b/supabase/migrations/004_tripgogo_schema_rls.sql
@@ -0,0 +1,771 @@
+-- ============================================================
+-- TRAVEL GOGO — isolated schema, authorization helpers, and RLS
+--
+-- All application-owned database objects use the tg_ prefix. The
+-- only shared Supabase object referenced is auth.users for identity.
+-- This migration does not read from or write to another site's tables.
+-- ============================================================
+
+create extension if not exists "pgcrypto";
+
+-- ------------------------------------------------------------
+-- Tables
+-- ------------------------------------------------------------
+
+create table if not exists public.tg_profiles (
+  id            uuid primary key references auth.users(id) on delete cascade,
+  email         text not null,
+  display_name  text,
+  created_at    timestamptz not null default now(),
+  updated_at    timestamptz not null default now(),
+  constraint tg_profiles_email_normalized_check check (email = lower(btrim(email)) and email <> '')
+);
+
+create unique index if not exists tg_profiles_email_unique_idx
+  on public.tg_profiles (lower(email));
+
+create table if not exists public.tg_trips (
+  id          uuid primary key default gen_random_uuid(),
+  owner_id    uuid not null references auth.users(id) on delete restrict,
+  name        text not null,
+  start_date  date not null,
+  end_date    date not null,
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now(),
+  constraint tg_trips_name_check check (btrim(name) <> ''),
+  constraint tg_trips_date_range_check check (end_date >= start_date)
+);
+
+create index if not exists tg_trips_owner_id_idx on public.tg_trips (owner_id);
+create index if not exists tg_trips_dates_idx on public.tg_trips (start_date, end_date);
+create index if not exists tg_trips_updated_at_idx on public.tg_trips (updated_at desc);
+
+create table if not exists public.tg_trip_members (
+  trip_id      uuid not null references public.tg_trips(id) on delete cascade,
+  user_id      uuid not null references auth.users(id) on delete cascade,
+  role         text not null,
+  invited_by   uuid references auth.users(id) on delete set null,
+  created_at   timestamptz not null default now(),
+  primary key (trip_id, user_id),
+  constraint tg_trip_members_role_check check (role in ('owner', 'editor'))
+);
+
+create index if not exists tg_trip_members_user_id_idx
+  on public.tg_trip_members (user_id, trip_id);
+create unique index if not exists tg_trip_members_one_owner_idx
+  on public.tg_trip_members (trip_id) where role = 'owner';
+
+create table if not exists public.tg_trip_invitations (
+  id           uuid primary key default gen_random_uuid(),
+  trip_id      uuid not null references public.tg_trips(id) on delete cascade,
+  email        text not null,
+  role         text not null default 'editor',
+  invited_by   uuid not null references auth.users(id) on delete cascade,
+  accepted_by  uuid references auth.users(id) on delete set null,
+  accepted_at  timestamptz,
+  created_at   timestamptz not null default now(),
+  expires_at   timestamptz,
+  constraint tg_trip_invitations_email_normalized_check check (email = lower(btrim(email)) and email <> ''),
+  constraint tg_trip_invitations_role_check check (role = 'editor'),
+  constraint tg_trip_invitations_acceptance_check check (
+    (accepted_by is null and accepted_at is null) or
+    (accepted_by is not null and accepted_at is not null)
+  )
+);
+
+create index if not exists tg_trip_invitations_trip_id_idx
+  on public.tg_trip_invitations (trip_id, created_at desc);
+create index if not exists tg_trip_invitations_email_idx
+  on public.tg_trip_invitations (lower(email));
+create unique index if not exists tg_trip_invitations_pending_unique_idx
+  on public.tg_trip_invitations (trip_id, lower(email)) where accepted_at is null;
+
+create table if not exists public.tg_travel_items (
+  id                 uuid primary key default gen_random_uuid(),
+  trip_id            uuid not null references public.tg_trips(id) on delete cascade,
+  created_by         uuid references auth.users(id) on delete set null,
+  type               text not null,
+  category           text not null default '',
+  area               text not null default '',
+  date               date,
+  name               text not null,
+  google_maps_url    text not null default '',
+  extra_link_1       text,
+  extra_link_2       text,
+  business_hours     text,
+  note               text not null default '',
+  sort_order         integer not null default 0,
+  created_at         timestamptz not null default now(),
+  updated_at         timestamptz not null default now(),
+  constraint tg_travel_items_type_check check (type in ('place', 'food')),
+  constraint tg_travel_items_name_check check (btrim(name) <> ''),
+  constraint tg_travel_items_sort_order_check check (sort_order >= 0)
+);
+
+create index if not exists tg_travel_items_trip_date_order_idx
+  on public.tg_travel_items (trip_id, date, sort_order, created_at);
+create index if not exists tg_travel_items_trip_type_idx
+  on public.tg_travel_items (trip_id, type);
+
+create table if not exists public.tg_flights (
+  id                uuid primary key default gen_random_uuid(),
+  trip_id           uuid not null references public.tg_trips(id) on delete cascade,
+  created_by        uuid references auth.users(id) on delete set null,
+  airline           text not null default '',
+  flight_number     text not null default '',
+  departure_place   text not null default '',
+  arrival_place     text not null default '',
+  departure_date    date not null,
+  departure_time    time not null,
+  arrival_date      date not null,
+  arrival_time      time not null,
+  link              text,
+  note              text,
+  created_at        timestamptz not null default now(),
+  updated_at        timestamptz not null default now(),
+  constraint tg_flights_time_range_check check (
+    (arrival_date + arrival_time) >= (departure_date + departure_time)
+  )
+);
+
+create index if not exists tg_flights_trip_departure_idx
+  on public.tg_flights (trip_id, departure_date, departure_time, created_at);
+
+create table if not exists public.tg_hotel_stays (
+  id              uuid primary key default gen_random_uuid(),
+  trip_id         uuid not null references public.tg_trips(id) on delete cascade,
+  created_by      uuid references auth.users(id) on delete set null,
+  name            text not null,
+  check_in_date   date not null,
+  check_out_date  date not null,
+  check_in_time   time,
+  check_out_time  time,
+  address         text,
+  phone           text,
+  google_maps_url text,
+  link            text,
+  note            text,
+  created_at      timestamptz not null default now(),
+  updated_at      timestamptz not null default now(),
+  constraint tg_hotel_stays_name_check check (btrim(name) <> ''),
+  constraint tg_hotel_stays_date_range_check check (check_out_date >= check_in_date)
+);
+
+create index if not exists tg_hotel_stays_trip_check_in_idx
+  on public.tg_hotel_stays (trip_id, check_in_date, created_at);
+
+create table if not exists public.tg_import_batches (
+  id                uuid primary key default gen_random_uuid(),
+  user_id           uuid not null references auth.users(id) on delete cascade,
+  payload_hash      text not null,
+  trip_count        integer not null default 0 check (trip_count >= 0),
+  item_count        integer not null default 0 check (item_count >= 0),
+  flight_count      integer not null default 0 check (flight_count >= 0),
+  hotel_stay_count  integer not null default 0 check (hotel_stay_count >= 0),
+  created_at        timestamptz not null default now(),
+  unique (user_id, payload_hash)
+);
+
+create index if not exists tg_import_batches_user_created_idx
+  on public.tg_import_batches (user_id, created_at desc);
+
+-- ------------------------------------------------------------
+-- Generic triggers and identity synchronization
+-- ------------------------------------------------------------
+
+create or replace function public.tg_set_updated_at()
+returns trigger
+language plpgsql
+set search_path = pg_catalog, public
+as $$
+begin
+  new.updated_at = now();
+  return new;
+end;
+$$;
+
+create or replace function public.tg_sync_profile_from_auth()
+returns trigger
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+begin
+  -- This shared Supabase project may also contain phone-only users from
+  -- another application. Do not make their auth lifecycle depend on Tripgogo.
+  if new.email is null or btrim(new.email) = '' then
+    return new;
+  end if;
+
+  insert into public.tg_profiles (id, email, display_name)
+  values (
+    new.id,
+    lower(btrim(coalesce(new.email, ''))),
+    nullif(btrim(coalesce(new.raw_user_meta_data ->> 'full_name', new.raw_user_meta_data ->> 'name', '')), '')
+  )
+  on conflict (id) do update
+    set email = excluded.email,
+        display_name = coalesce(excluded.display_name, public.tg_profiles.display_name),
+        updated_at = now();
+  return new;
+end;
+$$;
+
+drop trigger if exists tg_auth_user_profile_sync on auth.users;
+create trigger tg_auth_user_profile_sync
+  after insert or update of email, raw_user_meta_data on auth.users
+  for each row execute function public.tg_sync_profile_from_auth();
+
+drop trigger if exists tg_profiles_set_updated_at on public.tg_profiles;
+create trigger tg_profiles_set_updated_at before update on public.tg_profiles
+  for each row execute function public.tg_set_updated_at();
+drop trigger if exists tg_trips_set_updated_at on public.tg_trips;
+create trigger tg_trips_set_updated_at before update on public.tg_trips
+  for each row execute function public.tg_set_updated_at();
+drop trigger if exists tg_travel_items_set_updated_at on public.tg_travel_items;
+create trigger tg_travel_items_set_updated_at before update on public.tg_travel_items
+  for each row execute function public.tg_set_updated_at();
+drop trigger if exists tg_flights_set_updated_at on public.tg_flights;
+create trigger tg_flights_set_updated_at before update on public.tg_flights
+  for each row execute function public.tg_set_updated_at();
+drop trigger if exists tg_hotel_stays_set_updated_at on public.tg_hotel_stays;
+create trigger tg_hotel_stays_set_updated_at before update on public.tg_hotel_stays
+  for each row execute function public.tg_set_updated_at();
+
+-- ------------------------------------------------------------
+-- Authorization helpers. SECURITY DEFINER avoids recursive RLS
+-- checks on tg_trip_members; each function has a fixed search_path.
+-- ------------------------------------------------------------
+
+create or replace function public.tg_is_trip_member(p_trip_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = pg_catalog, public
+as $$
+  select exists (
+    select 1 from public.tg_trip_members
+    where trip_id = p_trip_id and user_id = auth.uid()
+  );
+$$;
+
+create or replace function public.tg_is_trip_owner(p_trip_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = pg_catalog, public
+as $$
+  select exists (
+    select 1 from public.tg_trips
+    where id = p_trip_id and owner_id = auth.uid()
+  );
+$$;
+
+create or replace function public.tg_create_owner_membership()
+returns trigger
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+begin
+  insert into public.tg_trip_members (trip_id, user_id, role, invited_by)
+  values (new.id, new.owner_id, 'owner', new.owner_id)
+  on conflict (trip_id, user_id) do update set role = 'owner';
+  return new;
+end;
+$$;
+
+drop trigger if exists tg_trips_create_owner_membership on public.tg_trips;
+create trigger tg_trips_create_owner_membership
+  after insert on public.tg_trips
+  for each row execute function public.tg_create_owner_membership();
+
+create or replace function public.tg_protect_trip_owner()
+returns trigger
+language plpgsql
+set search_path = pg_catalog, public
+as $$
+begin
+  if new.owner_id <> old.owner_id then
+    raise exception 'Trip ownership must be changed through a controlled ownership-transfer function';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists tg_trips_protect_owner on public.tg_trips;
+create trigger tg_trips_protect_owner
+  before update of owner_id on public.tg_trips
+  for each row execute function public.tg_protect_trip_owner();
+
+create or replace function public.tg_enforce_child_creator()
+returns trigger
+language plpgsql
+set search_path = pg_catalog, public
+as $$
+begin
+  if tg_op = 'INSERT' then
+    new.created_by = auth.uid();
+  elsif new.created_by is distinct from old.created_by then
+    raise exception 'created_by cannot be changed';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists tg_travel_items_enforce_creator on public.tg_travel_items;
+create trigger tg_travel_items_enforce_creator before insert or update on public.tg_travel_items
+  for each row execute function public.tg_enforce_child_creator();
+drop trigger if exists tg_flights_enforce_creator on public.tg_flights;
+create trigger tg_flights_enforce_creator before insert or update on public.tg_flights
+  for each row execute function public.tg_enforce_child_creator();
+drop trigger if exists tg_hotel_stays_enforce_creator on public.tg_hotel_stays;
+create trigger tg_hotel_stays_enforce_creator before insert or update on public.tg_hotel_stays
+  for each row execute function public.tg_enforce_child_creator();
+
+-- ------------------------------------------------------------
+-- Controlled member and invitation RPCs
+-- ------------------------------------------------------------
+
+create or replace function public.tg_invite_trip_member(
+  p_trip_id uuid,
+  p_email text,
+  p_expires_at timestamptz default null
+)
+returns public.tg_trip_invitations
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_email text := lower(btrim(p_email));
+  v_invitation public.tg_trip_invitations;
+begin
+  if auth.uid() is null or not public.tg_is_trip_owner(p_trip_id) then
+    raise exception 'Only the Trip owner can create invitations';
+  end if;
+  if v_email = '' or v_email !~ '^[^@[:space:]]+@[^@[:space:]]+[.][^@[:space:]]+$' then
+    raise exception 'A valid email address is required';
+  end if;
+  if p_expires_at is not null and p_expires_at <= now() then
+    raise exception 'Invitation expiry must be in the future';
+  end if;
+  if exists (
+    select 1
+    from public.tg_trip_members m
+    join public.tg_profiles p on p.id = m.user_id
+    where m.trip_id = p_trip_id and p.email = v_email
+  ) then
+    raise exception 'This account is already a Trip member';
+  end if;
+
+  insert into public.tg_trip_invitations (trip_id, email, role, invited_by, expires_at)
+  values (p_trip_id, v_email, 'editor', auth.uid(), p_expires_at)
+  on conflict (trip_id, (lower(email))) where accepted_at is null
+  do update set invited_by = excluded.invited_by,
+                expires_at = excluded.expires_at,
+                created_at = now()
+  returning * into v_invitation;
+
+  return v_invitation;
+end;
+$$;
+
+create or replace function public.tg_accept_trip_invitation(p_invitation_id uuid)
+returns uuid
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_email text := lower(btrim(coalesce(auth.jwt() ->> 'email', '')));
+  v_invitation public.tg_trip_invitations;
+begin
+  if v_user_id is null or v_email = '' then
+    raise exception 'Authentication with a verified email is required';
+  end if;
+
+  select * into v_invitation
+  from public.tg_trip_invitations
+  where id = p_invitation_id
+  for update;
+
+  if not found or v_invitation.accepted_at is not null then
+    raise exception 'Invitation is unavailable';
+  end if;
+  if v_invitation.expires_at is not null and v_invitation.expires_at <= now() then
+    raise exception 'Invitation has expired';
+  end if;
+  if v_invitation.email <> v_email then
+    raise exception 'Invitation email does not match the signed-in account';
+  end if;
+
+  insert into public.tg_trip_members (trip_id, user_id, role, invited_by)
+  values (v_invitation.trip_id, v_user_id, 'editor', v_invitation.invited_by)
+  on conflict (trip_id, user_id) do nothing;
+
+  update public.tg_trip_invitations
+  set accepted_by = v_user_id, accepted_at = now()
+  where id = p_invitation_id;
+
+  return v_invitation.trip_id;
+end;
+$$;
+
+create or replace function public.tg_revoke_trip_invitation(p_invitation_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_trip_id uuid;
+begin
+  select trip_id into v_trip_id
+  from public.tg_trip_invitations
+  where id = p_invitation_id and accepted_at is null;
+  if v_trip_id is null or not public.tg_is_trip_owner(v_trip_id) then
+    raise exception 'Only the Trip owner can revoke this invitation';
+  end if;
+  delete from public.tg_trip_invitations where id = p_invitation_id;
+end;
+$$;
+
+create or replace function public.tg_remove_trip_editor(p_trip_id uuid, p_user_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+begin
+  if auth.uid() is null or not public.tg_is_trip_owner(p_trip_id) then
+    raise exception 'Only the Trip owner can remove editors';
+  end if;
+  delete from public.tg_trip_members
+  where trip_id = p_trip_id and user_id = p_user_id and role = 'editor';
+end;
+$$;
+
+-- ------------------------------------------------------------
+-- One-time localStorage import RPC. The whole payload is imported
+-- atomically. Existing IDs are never overwritten, and the original
+-- browser data can remain untouched after a successful import.
+-- ------------------------------------------------------------
+
+create or replace function public.tg_import_local_data(p_payload jsonb)
+returns jsonb
+language plpgsql
+security definer
+set search_path = pg_catalog, public
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_hash text;
+  v_batch_id uuid;
+  v_trip_count integer;
+  v_item_count integer;
+  v_flight_count integer;
+  v_hotel_count integer;
+  v_row jsonb;
+  v_trip_id uuid;
+begin
+  if v_user_id is null then
+    raise exception 'Authentication is required';
+  end if;
+  if jsonb_typeof(p_payload) <> 'object'
+     or jsonb_typeof(coalesce(p_payload -> 'trips', '[]'::jsonb)) <> 'array'
+     or jsonb_typeof(coalesce(p_payload -> 'items', '[]'::jsonb)) <> 'array'
+     or jsonb_typeof(coalesce(p_payload -> 'flights', '[]'::jsonb)) <> 'array'
+     or jsonb_typeof(coalesce(p_payload -> 'hotelStays', '[]'::jsonb)) <> 'array' then
+    raise exception 'Invalid import payload';
+  end if;
+
+  v_hash := encode(digest(convert_to(p_payload::text, 'UTF8'), 'sha256'), 'hex');
+  if exists (
+    select 1 from public.tg_import_batches
+    where user_id = v_user_id and payload_hash = v_hash
+  ) then
+    raise exception 'This localStorage payload was already imported';
+  end if;
+
+  -- Validate every child relationship before writing anything.
+  for v_row in
+    select value from jsonb_array_elements(coalesce(p_payload -> 'items', '[]'::jsonb))
+    union all
+    select value from jsonb_array_elements(coalesce(p_payload -> 'flights', '[]'::jsonb))
+    union all
+    select value from jsonb_array_elements(coalesce(p_payload -> 'hotelStays', '[]'::jsonb))
+  loop
+    if not exists (
+      select 1 from jsonb_array_elements(coalesce(p_payload -> 'trips', '[]'::jsonb)) trip
+      where trip ->> 'id' = v_row ->> 'tripId'
+    ) then
+      raise exception 'Imported child record references a Trip outside this payload';
+    end if;
+  end loop;
+
+  -- Reject collisions rather than overwriting another import or account.
+  if exists (
+    select 1 from jsonb_array_elements(coalesce(p_payload -> 'trips', '[]'::jsonb)) x
+    join public.tg_trips t on t.id = (x ->> 'id')::uuid
+  ) or exists (
+    select 1 from jsonb_array_elements(coalesce(p_payload -> 'items', '[]'::jsonb)) x
+    join public.tg_travel_items i on i.id = (x ->> 'id')::uuid
+  ) or exists (
+    select 1 from jsonb_array_elements(coalesce(p_payload -> 'flights', '[]'::jsonb)) x
+    join public.tg_flights f on f.id = (x ->> 'id')::uuid
+  ) or exists (
+    select 1 from jsonb_array_elements(coalesce(p_payload -> 'hotelStays', '[]'::jsonb)) x
+    join public.tg_hotel_stays h on h.id = (x ->> 'id')::uuid
+  ) then
+    raise exception 'An imported record ID already exists; no data was changed';
+  end if;
+
+  for v_row in select value from jsonb_array_elements(coalesce(p_payload -> 'trips', '[]'::jsonb)) loop
+    v_trip_id := (v_row ->> 'id')::uuid;
+    insert into public.tg_trips (id, owner_id, name, start_date, end_date, created_at, updated_at)
+    values (
+      v_trip_id,
+      v_user_id,
+      v_row ->> 'name',
+      (v_row ->> 'startDate')::date,
+      (v_row ->> 'endDate')::date,
+      coalesce((v_row ->> 'createdAt')::timestamptz, now()),
+      coalesce((v_row ->> 'updatedAt')::timestamptz, now())
+    );
+  end loop;
+
+  for v_row in select value from jsonb_array_elements(coalesce(p_payload -> 'items', '[]'::jsonb)) loop
+    insert into public.tg_travel_items (
+      id, trip_id, created_by, type, category, area, date, name, google_maps_url,
+      extra_link_1, extra_link_2, business_hours, note, sort_order, created_at, updated_at
+    ) values (
+      (v_row ->> 'id')::uuid,
+      (v_row ->> 'tripId')::uuid,
+      v_user_id,
+      v_row ->> 'type',
+      coalesce(v_row ->> 'category', ''),
+      coalesce(v_row ->> 'area', ''),
+      nullif(v_row ->> 'date', '')::date,
+      v_row ->> 'name',
+      coalesce(v_row ->> 'googleMapsUrl', ''),
+      nullif(v_row ->> 'extraLink1', ''),
+      nullif(v_row ->> 'extraLink2', ''),
+      nullif(v_row ->> 'businessHours', ''),
+      coalesce(v_row ->> 'note', ''),
+      greatest(coalesce((v_row ->> 'order')::integer, 0), 0),
+      coalesce((v_row ->> 'createdAt')::timestamptz, now()),
+      coalesce((v_row ->> 'updatedAt')::timestamptz, now())
+    );
+  end loop;
+
+  for v_row in select value from jsonb_array_elements(coalesce(p_payload -> 'flights', '[]'::jsonb)) loop
+    insert into public.tg_flights (
+      id, trip_id, created_by, airline, flight_number, departure_place, arrival_place,
+      departure_date, departure_time, arrival_date, arrival_time, link, note, created_at, updated_at
+    ) values (
+      (v_row ->> 'id')::uuid,
+      (v_row ->> 'tripId')::uuid,
+      v_user_id,
+      coalesce(v_row ->> 'airline', ''),
+      coalesce(v_row ->> 'flightNumber', ''),
+      coalesce(v_row ->> 'departurePlace', ''),
+      coalesce(v_row ->> 'arrivalPlace', ''),
+      (v_row ->> 'departureDate')::date,
+      (v_row ->> 'departureTime')::time,
+      (v_row ->> 'arrivalDate')::date,
+      (v_row ->> 'arrivalTime')::time,
+      nullif(v_row ->> 'link', ''),
+      nullif(v_row ->> 'note', ''),
+      coalesce((v_row ->> 'createdAt')::timestamptz, now()),
+      coalesce((v_row ->> 'updatedAt')::timestamptz, now())
+    );
+  end loop;
+
+  for v_row in select value from jsonb_array_elements(coalesce(p_payload -> 'hotelStays', '[]'::jsonb)) loop
+    insert into public.tg_hotel_stays (
+      id, trip_id, created_by, name, check_in_date, check_out_date, check_in_time,
+      check_out_time, address, phone, google_maps_url, link, note, created_at, updated_at
+    ) values (
+      (v_row ->> 'id')::uuid,
+      (v_row ->> 'tripId')::uuid,
+      v_user_id,
+      v_row ->> 'name',
+      (v_row ->> 'checkInDate')::date,
+      (v_row ->> 'checkOutDate')::date,
+      nullif(v_row ->> 'checkInTime', '')::time,
+      nullif(v_row ->> 'checkOutTime', '')::time,
+      nullif(v_row ->> 'address', ''),
+      nullif(v_row ->> 'phone', ''),
+      nullif(v_row ->> 'googleMapsUrl', ''),
+      nullif(v_row ->> 'link', ''),
+      nullif(v_row ->> 'note', ''),
+      coalesce((v_row ->> 'createdAt')::timestamptz, now()),
+      coalesce((v_row ->> 'updatedAt')::timestamptz, now())
+    );
+  end loop;
+
+  v_trip_count := jsonb_array_length(coalesce(p_payload -> 'trips', '[]'::jsonb));
+  v_item_count := jsonb_array_length(coalesce(p_payload -> 'items', '[]'::jsonb));
+  v_flight_count := jsonb_array_length(coalesce(p_payload -> 'flights', '[]'::jsonb));
+  v_hotel_count := jsonb_array_length(coalesce(p_payload -> 'hotelStays', '[]'::jsonb));
+
+  insert into public.tg_import_batches (
+    user_id, payload_hash, trip_count, item_count, flight_count, hotel_stay_count
+  ) values (
+    v_user_id, v_hash, v_trip_count, v_item_count, v_flight_count, v_hotel_count
+  ) returning id into v_batch_id;
+
+  return jsonb_build_object(
+    'batchId', v_batch_id,
+    'tripCount', v_trip_count,
+    'itemCount', v_item_count,
+    'flightCount', v_flight_count,
+    'hotelStayCount', v_hotel_count
+  );
+end;
+$$;
+
+-- ------------------------------------------------------------
+-- RLS
+-- ------------------------------------------------------------
+
+alter table public.tg_profiles enable row level security;
+alter table public.tg_trips enable row level security;
+alter table public.tg_trip_members enable row level security;
+alter table public.tg_trip_invitations enable row level security;
+alter table public.tg_travel_items enable row level security;
+alter table public.tg_flights enable row level security;
+alter table public.tg_hotel_stays enable row level security;
+alter table public.tg_import_batches enable row level security;
+
+-- Profiles are never anonymous-readable. Authenticated users see their own
+-- profile; Trip owners can see profiles for members of Trips they own.
+create policy "tg_profiles_authenticated_read" on public.tg_profiles
+  for select to authenticated
+  using (
+    id = auth.uid() or exists (
+      select 1 from public.tg_trip_members m
+      where m.user_id = tg_profiles.id and public.tg_is_trip_owner(m.trip_id)
+    )
+  );
+create policy "tg_profiles_update_self" on public.tg_profiles
+  for update to authenticated
+  using (id = auth.uid())
+  with check (
+    id = auth.uid()
+    and email = lower(btrim(coalesce(auth.jwt() ->> 'email', '')))
+  );
+
+-- Trip and itinerary content is publicly readable.
+create policy "tg_trips_public_read" on public.tg_trips
+  for select to anon, authenticated using (true);
+create policy "tg_travel_items_public_read" on public.tg_travel_items
+  for select to anon, authenticated using (true);
+create policy "tg_flights_public_read" on public.tg_flights
+  for select to anon, authenticated using (true);
+create policy "tg_hotel_stays_public_read" on public.tg_hotel_stays
+  for select to anon, authenticated using (true);
+
+create policy "tg_trips_authenticated_create" on public.tg_trips
+  for insert to authenticated with check (owner_id = auth.uid());
+create policy "tg_trips_members_update" on public.tg_trips
+  for update to authenticated
+  using (public.tg_is_trip_member(id))
+  with check (public.tg_is_trip_member(id));
+create policy "tg_trips_owner_delete" on public.tg_trips
+  for delete to authenticated using (public.tg_is_trip_owner(id));
+
+create policy "tg_travel_items_members_create" on public.tg_travel_items
+  for insert to authenticated
+  with check (public.tg_is_trip_member(trip_id) and created_by = auth.uid());
+create policy "tg_travel_items_members_update" on public.tg_travel_items
+  for update to authenticated
+  using (public.tg_is_trip_member(trip_id))
+  with check (public.tg_is_trip_member(trip_id));
+create policy "tg_travel_items_members_delete" on public.tg_travel_items
+  for delete to authenticated using (public.tg_is_trip_member(trip_id));
+
+create policy "tg_flights_members_create" on public.tg_flights
+  for insert to authenticated
+  with check (public.tg_is_trip_member(trip_id) and created_by = auth.uid());
+create policy "tg_flights_members_update" on public.tg_flights
+  for update to authenticated
+  using (public.tg_is_trip_member(trip_id))
+  with check (public.tg_is_trip_member(trip_id));
+create policy "tg_flights_members_delete" on public.tg_flights
+  for delete to authenticated using (public.tg_is_trip_member(trip_id));
+
+create policy "tg_hotel_stays_members_create" on public.tg_hotel_stays
+  for insert to authenticated
+  with check (public.tg_is_trip_member(trip_id) and created_by = auth.uid());
+create policy "tg_hotel_stays_members_update" on public.tg_hotel_stays
+  for update to authenticated
+  using (public.tg_is_trip_member(trip_id))
+  with check (public.tg_is_trip_member(trip_id));
+create policy "tg_hotel_stays_members_delete" on public.tg_hotel_stays
+  for delete to authenticated using (public.tg_is_trip_member(trip_id));
+
+-- Membership and invitation writes deliberately have no direct policies.
+-- Only the controlled SECURITY DEFINER RPCs above may write these tables.
+create policy "tg_trip_members_read_self_or_owner" on public.tg_trip_members
+  for select to authenticated
+  using (user_id = auth.uid() or public.tg_is_trip_owner(trip_id));
+create policy "tg_trip_invitations_read_owner_or_invitee" on public.tg_trip_invitations
+  for select to authenticated
+  using (
+    public.tg_is_trip_owner(trip_id)
+    or email = lower(btrim(coalesce(auth.jwt() ->> 'email', '')))
+  );
+create policy "tg_import_batches_read_self" on public.tg_import_batches
+  for select to authenticated using (user_id = auth.uid());
+
+-- ------------------------------------------------------------
+-- Function/table grants. RLS remains the data authorization boundary.
+-- ------------------------------------------------------------
+
+revoke all on function public.tg_is_trip_member(uuid) from public;
+revoke all on function public.tg_is_trip_owner(uuid) from public;
+revoke all on function public.tg_invite_trip_member(uuid, text, timestamptz) from public;
+revoke all on function public.tg_accept_trip_invitation(uuid) from public;
+revoke all on function public.tg_revoke_trip_invitation(uuid) from public;
+revoke all on function public.tg_remove_trip_editor(uuid, uuid) from public;
+revoke all on function public.tg_import_local_data(jsonb) from public;
+revoke all on function public.tg_set_updated_at() from public;
+revoke all on function public.tg_sync_profile_from_auth() from public;
+revoke all on function public.tg_create_owner_membership() from public;
+revoke all on function public.tg_protect_trip_owner() from public;
+revoke all on function public.tg_enforce_child_creator() from public;
+
+grant execute on function public.tg_is_trip_member(uuid) to authenticated;
+grant execute on function public.tg_is_trip_owner(uuid) to authenticated;
+grant execute on function public.tg_invite_trip_member(uuid, text, timestamptz) to authenticated;
+grant execute on function public.tg_accept_trip_invitation(uuid) to authenticated;
+grant execute on function public.tg_revoke_trip_invitation(uuid) to authenticated;
+grant execute on function public.tg_remove_trip_editor(uuid, uuid) to authenticated;
+grant execute on function public.tg_import_local_data(jsonb) to authenticated;
+
+grant select on public.tg_trips, public.tg_travel_items, public.tg_flights, public.tg_hotel_stays
+  to anon, authenticated;
+grant select, insert, update, delete on public.tg_trips, public.tg_travel_items, public.tg_flights, public.tg_hotel_stays
+  to authenticated;
+grant select, update on public.tg_profiles to authenticated;
+grant select on public.tg_trip_members, public.tg_trip_invitations, public.tg_import_batches
+  to authenticated;
+
+-- Backfill profiles for users who existed before this migration. This only
+-- writes Tripgogo's tg_profiles table; auth.users is read as identity source.
+insert into public.tg_profiles (id, email, display_name)
+select
+  u.id,
+  lower(btrim(u.email)),
+  nullif(btrim(coalesce(u.raw_user_meta_data ->> 'full_name', u.raw_user_meta_data ->> 'name', '')), '')
+from auth.users u
+where u.email is not null and btrim(u.email) <> ''
+on conflict (id) do update
+  set email = excluded.email,
+      display_name = coalesce(excluded.display_name, public.tg_profiles.display_name),
+      updated_at = now();
