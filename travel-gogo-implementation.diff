+import { displayDate, tripDates } from "@/lib/travel-dates";
+import { getBusinessStatus, type BusinessStatus } from "@/lib/business-hours";
+import { travelRepository } from "@/lib/travel-storage";
+import type { Flight, HotelStay, TravelItem, TravelItemSort, TravelItemType, Trip } from "@/lib/types";
+
+type Tab = "daily" | "place" | "food" | "outline";
+const CARD_SECTION_SPACING = "pb-6";
+
+export function TripWorkspace({ tripId }: { tripId: string }) {
+  const [trip, setTrip] = useState<Trip>();
+  const [items, setItems] = useState<TravelItem[]>([]);
+  const [tab, setTab] = useState<Tab>("daily");
+  const [query, setQuery] = useState("");
+  const [sort, setSort] = useState<TravelItemSort>("date");
+  const [dialog, setDialog] = useState<{ open: boolean; type: TravelItemType; item?: TravelItem }>({ open: false, type: "place" });
+  const [deleting, setDeleting] = useState<TravelItem>();
+  const refresh = useCallback(() => { setTrip(travelRepository.getTrip(tripId)); setItems(travelRepository.getItems(tripId)); }, [tripId]);
+  useEffect(() => refresh(), [refresh]);
